  "program": {
    "schema": 1,
    "game": "vn-stage-dsl",
    "version": "dsl-demo-v1",
    "entry": "start",
    "variables": {
      "trust": {
        "initial": 0,
        "min": 0,
        "max": 2
      }
    },
    "blocks": [
      {
        "id": "start",
        "title": "舞台开场",
        "lines": [
          {
            "id": "hello",
            "speaker": "旁白",
            "text": "背景、立绘和声音来自同一份演出文本。",
            "cue": {
              "portrait": "student",
              "voice": "greeting",
              "sound": "bell",
              "pauseMs": 120,
              "effect": {
                "type": "fade",
                "durationMs": 150
              }
            }
          },
          {
            "id": "question",
            "speaker": "旁白",
            "text": "请选择一条路线，读档仍从真实选择重建。"
          }
        ],
        "cue": {
          "background": "classroom",
          "music": "bgm",
          "ambience": "air"
        },
        "exit": {
          "type": "choice",
          "choices": [
            {
              "id": "yes",
              "text": "继续演出",
              "next": "finish",
              "effects": [
                {
                  "op": "add",
                  "key": "trust",
                  "value": 1
                }
              ]
            },
            {
              "id": "no",
              "text": "安静离开",
              "next": "quiet"
            }
          ]
        }
      },
      {
        "id": "finish",
        "title": "完成",
        "lines": [
          {
            "id": "done",
            "speaker": "旁白",
            "text": "插图出现，音乐停止，演出完成。",
            "cue": {
              "cg": "letter",
              "portrait": null,
              "effect": {
                "type": "flash",
                "durationMs": 100
              }
            }
          }
        ],
        "cue": {
          "background": "bedroom",
          "music": null,
          "ambience": null
        },
        "exit": {
          "type": "end",
          "ending": "good"
        }
      },
      {
        "id": "quiet",
        "title": "离开",
        "lines": [
          {
            "id": "quiet-line",
            "speaker": "旁白",
            "text": "画面保留，人物和音乐清除。"
          }
        ],
        "cue": {
          "portrait": null,
          "music": null,
          "ambience": null
        },
        "exit": {
          "type": "end",
          "ending": "neutral"
        }
      }
    ]
  },
  "routeTests": {
    "schema": 1,
    "cases": [
      {
