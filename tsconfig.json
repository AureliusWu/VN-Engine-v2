{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "declaration": true,
    "sourceMap": true, "rootDir": "src", "outDir": "dist",
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
