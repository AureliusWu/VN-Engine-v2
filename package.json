{
  "name": "@aureliuswu/vn-engine-v2",
  "version": "0.3.1",
  "description": "Self-developed narrative engine: script VM, VN/chat/investigation runtimes, DOM player and offline game builds",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pwa": "./tools/pwa.mjs",
    "./validation": "./tools/validate-graph.mjs",
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:renpy": "python -m unittest discover -s tests/renpy -v",
    "test:browser": "npm run build && node tests/browser.mjs && node tests/runtime-browser.mjs && node tests/runtime-stability-browser.mjs && node tests/editor-browser.mjs",
    "demo": "npm run build && node tools/serve.mjs",
    "check": "npm test && npm run test:renpy && node tools/check-provenance.mjs",
    "verify:upstream": "npm run build && node tools/compare-upstream.mjs",
    "build:game": "npm run build && node tools/package-game.mjs",
    "verify:rain": "npm run build && node tools/compare-rain-runtime.mjs",
    "benchmark": "npm run build && node tools/benchmark-runtime.mjs",
    "build:studio": "npm run build && node tools/package-studio.mjs",
    "test:editor": "npm run build && node tests/editor-browser.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "playwright": "1.63.0"
  }
}
