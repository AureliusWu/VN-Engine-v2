{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vn-creative-v1:production",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "brief": {
      "type": "object",
      "properties": {
        "premise": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "tone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "visualStyle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "musicDirection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "soundDirection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "writingStyle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "visualPrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "voiceNotes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": true
      },
      "maxItems": 64
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nodeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "\\S"
                },
                "chapterId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "\\S"
                },
                "lineId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "nodeId"
              ],
              "additionalProperties": true
            },
            "maxItems": 64
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "maxItems": 64
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "maxItems": 128
          }
        },
        "required": [
          "id",
          "summary",
          "targets"
        ],
        "additionalProperties": true
      },
      "maxItems": 256
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "art",
              "music",
              "ui",
              "sfx",
              "text",
              "story"
            ]
          },
          "brief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "state": {
            "enum": [
              "planned",
              "draft",
              "review"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "maxItems": 128
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "maxItems": 64
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nodeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "\\S"
                },
                "chapterId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "\\S"
                },
                "lineId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "nodeId"
              ],
              "additionalProperties": true
            },
            "maxItems": 64
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "maxItems": 64
          },
          "source": {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "generated",
                  "composed",
                  "procedural",
                  "licensed",
                  "recorded",
                  "authored"
                ]
              },
              "tool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "speaker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "sourceSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "notes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            },
            "required": [
              "method",
              "tool"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "kind",
          "brief",
          "state"
        ],
        "additionalProperties": true
      },
      "maxItems": 128
    }
  },
  "required": [
    "schema"
  ],
  "additionalProperties": true
}
